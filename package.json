{
  "name": "legion-library",
  "version": "0.1.0",
  "description": "A unified Gaming Mode library for Steam and non-Steam shortcuts",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "build": "rollup -c",
    "typecheck": "tsc --noEmit",
    "test": "python -m unittest discover -s tests -v && node --test tests/model.test.mjs tests/artwork.test.mjs",
    "test:bundle": "node --test tests/bundle.test.mjs",
    "preview": "vite --host 127.0.0.1",
    "preview:build": "vite build",
    "package": "python scripts/package.py"
  },
  "dependencies": {
    "@decky/api": "1.1.3",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@decky/ui": "4.12.1",
    "@rollup/plugin-commonjs": "26.0.3",
    "@rollup/plugin-node-resolve": "15.3.1",
    "@rollup/plugin-replace": "5.0.7",
    "@rollup/plugin-typescript": "11.1.6",
    "rollup-plugin-external-globals": "0.11.0",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "rollup": "4.64.5",
    "typescript": "5.9.3",
    "vite": "6.4.4"
  }
}
